[Unit]
Description=Internal DNS zone publisher for %i
After=network-online.target coredns.service
Wants=network-online.target

[Service]
User=coredns
Group=coredns
EnvironmentFile=/etc/dns-manager/node-%i.env
ExecStart=/usr/local/bin/dns-node -zone ${ZONE} -file ${ZONE_FILE} -dns ${DNS_ADDRESS} -listen ${LISTEN} -tls-cert ${TLS_CERT} -tls-key ${TLS_KEY} -client-ca ${CLIENT_CA}
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/coredns/zones

[Install]
WantedBy=multi-user.target
