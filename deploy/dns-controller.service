[Unit]
Description=Internal DNS controller
After=network-online.target
Wants=network-online.target

[Service]
User=dns-controller
Group=dns-controller
StateDirectory=dns-controller
EnvironmentFile=/etc/dns-manager/controller.env
ExecStart=/usr/local/bin/dns-controller -listen ${LISTEN} -config /etc/dns-manager/controller.json -state /var/lib/dns-controller/releases.json -tls-cert ${TLS_CERT} -tls-key ${TLS_KEY} -node-ca ${NODE_CA} -node-client-cert ${CLIENT_CERT} -node-client-key ${CLIENT_KEY}
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
